{
  "manifest_version": 2,
  "name": "编号批量引用 · Batch Citations",
  "version": "1.1.13",
  "description": "配合 Word 加载项在当前文档批量插入编号引用，复用 Zotero 文献关联与动态刷新。保留 DOCX 导出。",
  "icons": {
    "48": "content/icons/batch-citations.svg",
    "96": "content/icons/batch-citations.svg"
  },
  "applications": {
    "zotero": {
      "id": "batch-citations@nanyan.local",
      "update_url": "https://example.invalid/zotero-batch-citations/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  }
}
